; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="JunkRiot"
run/main_scene="res://scenes/ui/SplashScreen.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/ui/JunkRiotLogo.png"

[autoload]

EconomyManager="*uid://r3cdktae487x"
RunBonuses="*uid://b1u65qfmje85t"
RewardManager="*uid://dah8ytkok5nlg"
RunDeck="*uid://cvdot5vjlnodg"
RewardDB="*uid://53rf7p6jsqdf"
Player="*uid://bqkkdnoe8et57"
Audio="*res://scripts/managers/audio_manager.gd"
Progress="*res://scripts/managers/progress_manager.gd"
Juice="*res://scripts/managers/juice_manager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=2

[layer_names]

2d_physics/layer_1="Ennemi"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/use_physical_light_units=true
